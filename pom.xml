<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>parent</artifactId>
        <groupId>com.loudsight</groupId>
        <version>0.1.0</version>
    </parent>

    <groupId>com.loudsight.meta</groupId>
    <artifactId>entity-meta-generator</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Loudsight entity-meta-generator Parent</name>
    <description>Loudsight entity-meta-generator Module</description>
    <url>https://loudsight.com/</url>

    <licenses>
        <license>
            <name>Loudsight Apache License 2.0 (Apache-2.0)</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Loudsight loudsight</name>
            <email>spam@loudsight.com</email>
            <organization>Loudsight</organization>
            <organizationUrl>https://loudsight.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git@github.com:loudsight/entity-meta-generator.git</connection>
        <developerConnection>scm:git@github.com:loudsight/entity-meta-generator.git</developerConnection>
        <url>git@github.com:loudsight/entity-meta-generator.git</url>
    </scm>

    <properties>
        <release.arguments />
    </properties>

    <modules>
        <module>entity-meta-generator-lib</module>
        <module>entity-meta-processor</module>
        <module>entity-meta-processor-tests</module>
        <module>codemap-processor</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The maven-compiler-plugin entry here used combine.self="override" with an empty
              annotationProcessorPaths, to escape an entity-meta-processor path the parent once
              applied unconditionally - this tree builds that processor and cannot be compiled by
              it. That path is now behind the parent's entity-meta-processing profile, which this
              module opts out of via .no-entity-meta, so the override suppressed nothing.

              Overriding the whole <configuration> is what made it dangerous to keep: it discarded
              the inherited compilerArgs as well, so Error Prone would have been silently absent
              here while running everywhere else.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
